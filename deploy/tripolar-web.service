[Unit]
Description=Tripolar Web (API + Frontend)
After=network.target postgresql.service

[Service]
Type=simple
User=tripolar
WorkingDirectory=/opt/tripolar/backend
ExecStart=/opt/tripolar/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
